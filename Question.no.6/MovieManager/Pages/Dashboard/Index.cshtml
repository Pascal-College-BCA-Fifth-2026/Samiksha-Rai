@page
@model MovieManager.Pages.Dashboard.IndexModel
@inject MovieManager.Data.AppDbContext DbContext
@{
    var totalMovies = DbContext.Movies.Count();
    var totalActors = DbContext.Actors.Count();
    var totalCharacters = DbContext.Characters.Count();
}

<div class="dashboard-page">

    <div class="page-header">
        <div class="page-header-row">
            <div class="page-header-info">
                <h1>Dashboard</h1>
                <p>Overview of your movie catalog</p>
            </div>
        </div>
    </div>

    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#888888" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="20" rx="2.5"/>
                    <line x1="2" y1="8" x2="22" y2="8"/>
                    <line x1="8" y1="2" x2="8" y2="22"/>
                </svg>
            </div>
            <div class="stat-card-info">
                <span class="stat-card-label">Total Movies</span>
                <span class="stat-card-value">@totalMovies</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#888888" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M7 21v-2a4 4 0 0 1 3-3.87"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </div>
            <div class="stat-card-info">
                <span class="stat-card-label">Total Actors</span>
                <span class="stat-card-value">@totalActors</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#888888" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </div>
            <div class="stat-card-info">
                <span class="stat-card-label">Total Characters</span>
                <span class="stat-card-value">@totalCharacters</span>
            </div>
        </div>
    </div>

    <div class="table-grid">
        <div class="table-container">
            <div class="table-container-header">
                <h2 class="table-container-title">Top 10 Flop Movies</h2>
                <span class="badge">Loss Leader</span>
            </div>
            <div class="table-responsive">
                @if (Model.FlopMovies.Any())
                {
                    <table>
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th class="text-end">Budget</th>
                                <th class="text-end">Gross</th>
                                <th class="text-end">Loss</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var movie in Model.FlopMovies)
                            {
                                <tr>
                                    <td class="cell-title">@movie.Title</td>
                                    <td class="text-end cell-mono">@movie.Budget.ToString("C")</td>
                                    <td class="text-end cell-mono">@movie.Gross.ToString("C")</td>
                                    <td class="text-end cell-loss">@movie.Loss.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <p class="empty-state-title">No flop movies found.</p>
                        <p class="empty-state-message">All movies are currently profitable.</p>
                    </div>
                }
            </div>
        </div>
        <div class="table-container">
            <div class="table-container-header">
                <h2 class="table-container-title">Top 5 Highest Paid Actors</h2>
                <span class="badge">Top Earner</span>
            </div>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Actor</th>
                            <th>Character</th>
                            <th>Movie</th>
                            <th class="text-end">Pay</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var actor in Model.HighestPaidActors)
                        {
                            <tr>
                                <td class="cell-title">@actor.ActorName</td>
                                <td class="cell-subtle">@actor.CharacterName</td>
                                <td class="cell-subtle">@actor.MovieTitle</td>
                                <td class="text-end cell-mono">@actor.Pay.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<style>
.dashboard-page {
    padding: 32px 0;
}

.page-header {
    margin-bottom: 32px;
}

.page-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}

.page-header-info h1 {
    font-family: Inter, system-ui, -apple-system, sans-serif;
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -1.28px;
    color: var(--color-ink, #171717);
    margin: 0 0 4px;
    line-height: 40px;
}

.page-header-info p {
    font-family: Inter, system-ui, -apple-system, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: var(--color-muted, #888888);
    margin: 0;
    line-height: 20px;
}

.stat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 32px;
}

.stat-card {
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-hairline, #ebebeb);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 1px 1px rgba(0,0,0,0.03);
}

.stat-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--color-canvas, #fafafa);
    flex-shrink: 0;
}

.stat-card-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.stat-card-label {
    font-family: Inter, system-ui, -apple-system, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: var(--color-muted, #888888);
    line-height: 20px;
}

.stat-card-value {
    font-family: Inter, system-ui, -apple-system, sans-serif;
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -1.28px;
    color: var(--color-ink, #171717);
    line-height: 40px;
}

.table-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 16px;
}

.table-container {
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-hairline, #ebebeb);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 1px rgba(0,0,0,0.03), 0 2px 2px rgba(0,0,0,0.04), 0 0 0 1px rgba(0,0,0,0.04) inset;
}

.table-container-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 16px 0;
}

.table-container-title {
    font-family: Inter, system-ui, -apple-system, sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-ink, #171717);
    margin: 0;
    line-height: 24px;
}

.badge {
    font-family: Inter, system-ui, -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: var(--color-body, #4d4d4d);
    background: var(--color-canvas, #fafafa);
    border: 1px solid var(--color-hairline, #ebebeb);
    border-radius: 9999px;
    padding: 2px 10px;
    line-height: 18px;
    white-space: nowrap;
}

.table-container table {
    margin: 0;
    width: 100%;
}

.table-container thead th {
    font-family: Inter, system-ui, -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-muted, #888888);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 10px 16px;
    border-bottom: 1px solid var(--color-hairline, #ebebeb);
    background: var(--color-canvas, #fafafa);
    line-height: 16px;
    white-space: nowrap;
}

.table-container tbody td {
    font-family: Inter, system-ui, -apple-system, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: var(--color-body, #4d4d4d);
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-hairline, #ebebeb);
    vertical-align: middle;
    line-height: 20px;
}

.table-container tbody tr:last-child td {
    border-bottom: none;
}

.table-container tbody tr:hover td {
    background: var(--color-surface-hover, #f5f5f5);
}

.cell-title {
    color: var(--color-ink, #171717) !important;
    font-weight: 500 !important;
}

.cell-subtle {
    color: var(--color-muted, #888888) !important;
}

.cell-mono {
    font-family: ui-monospace, SF Mono, Menlo, monospace !important;
    font-size: 13px !important;
}

.cell-loss {
    font-family: ui-monospace, SF Mono, Menlo, monospace !important;
    font-size: 13px !important;
    color: var(--color-ink, #171717) !important;
    font-weight: 500 !important;
}

.empty-state {
    padding: 32px 16px;
    text-align: center;
}

.empty-state-title {
    font-family: Inter, system-ui, -apple-system, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink, #171717);
    margin: 0 0 4px;
    line-height: 20px;
}

.empty-state-message {
    font-family: Inter, system-ui, -apple-system, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: var(--color-muted, #888888);
    margin: 0;
    line-height: 20px;
}

@@media (max-width: 991px) {
    .stat-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .table-grid {
        grid-template-columns: 1fr;
    }
}

@@media (max-width: 575px) {
    .dashboard-page {
        padding: 24px 0;
    }

    .page-header-row {
        flex-direction: column;
        align-items: stretch;
    }

    .stat-grid {
        grid-template-columns: 1fr;
    }

    .stat-card {
        padding: 16px;
    }

    .stat-card-icon {
        width: 40px;
        height: 40px;
    }

    .stat-card-value {
        font-size: 28px;
        letter-spacing: -1px;
        line-height: 36px;
    }

    .table-container-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }
}
</style>