@page "{id}"
@model MovieManager.Pages.Actors.DetailsModel

<div class="page-header">
    <h1>@Model.Actor.Name</h1>
    <p>Actor details and biography</p>
</div>

<div class="card">
    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Name</span>
            <span class="detail-value">@Model.Actor.Name</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Date of Birth</span>
            <span class="detail-value">@Model.Actor.DateOfBirth.ToShortDateString()</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Birth City</span>
            <span class="detail-value">@Model.Actor.BirthCity</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Birth Country</span>
            <span class="detail-value">@Model.Actor.BirthCountry</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Height</span>
            <span class="detail-value">@Model.Actor.HeightInches in</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Gender</span>
            <span class="detail-value">@Model.Actor.Gender</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Net Worth</span>
            <span class="detail-value">@Model.Actor.NetWorth.ToString("C")</span>
        </div>
        <div class="detail-item full-width">
            <span class="detail-label">Biography</span>
            <span class="detail-value">@Model.Actor.Biography</span>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-page="Edit" asp-route-id="@Model.Actor.Id">Edit</a>
        <a class="btn btn-outline" asp-page="Index">Back to List</a>
    </div>
</div>