@page "{id}"
@model MovieManager.Pages.Actors.DeleteModel

<div class="page-header">
    <h1>Delete Actor</h1>
    <p>Are you sure you want to delete this actor? This action cannot be undone.</p>
</div>

<form method="post">
    <div class="card delete-card">
        <div class="delete-warning">
            <div class="delete-warning-icon">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 4.5v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <circle cx="8" cy="11.5" r="0.75" fill="currentColor"/>
                </svg>
            </div>
            <div class="delete-warning-content">
                <strong>You are about to delete this item</strong>
                <p>This will permanently remove @Model.Actor.Name from the system.</p>
            </div>
        </div>

        <div class="detail-grid">
            <div class="detail-item">
                <span class="detail-label">Name</span>
                <span class="detail-value">@Model.Actor.Name</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Date of Birth</span>
                <span class="detail-value">@Model.Actor.DateOfBirth.ToShortDateString()</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Birth City</span>
                <span class="detail-value">@Model.Actor.BirthCity</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Birth Country</span>
                <span class="detail-value">@Model.Actor.BirthCountry</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Height</span>
                <span class="detail-value">@Model.Actor.HeightInches in</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Gender</span>
                <span class="detail-value">@Model.Actor.Gender</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Net Worth</span>
                <span class="detail-value">@Model.Actor.NetWorth.ToString("C")</span>
            </div>
            <div class="detail-item full-width">
                <span class="detail-label">Biography</span>
                <span class="detail-value">@Model.Actor.Biography</span>
            </div>
        </div>
        <div class="page-actions">
            <button type="submit" class="btn btn-danger">Delete Actor</button>
            <a class="btn btn-outline" asp-page="Index">Cancel</a>
        </div>
    </div>
</form>