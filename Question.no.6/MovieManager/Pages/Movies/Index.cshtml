@page
@model MovieManager.Pages.Movies.IndexModel

<div class="py-4">

    <div class="page-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h1>Movies</h1>
            <p>Manage your movie catalog</p>
        </div>
        <a asp-page="Create" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Create Movie
        </a>
    </div>

    @if (Model.Movies.Count == 0)
    {
        <div class="empty-state">
            <div class="mb-3 d-flex justify-content-center">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#a1a1a1" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="20" rx="2.5"/>
                    <line x1="2" y1="8" x2="22" y2="8"/>
                    <line x1="8" y1="2" x2="8" y2="22"/>
                </svg>
            </div>
            <h3 class="empty-state-title">No movies yet</h3>
            <p class="empty-state-text">Get started by adding your first movie to the catalog.</p>
            <a asp-page="Create" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                Create Movie
            </a>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-responsive">
                <table class="mb-0">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Genre</th>
                            <th>Rating</th>
                            <th>Release Date</th>
                            <th>Runtime</th>
                            <th>Budget</th>
                            <th>Gross</th>
                            <th class="actions-col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movie in Model.Movies)
                        {
                            <tr>
                                <td class="cell-title">@movie.Title</td>
                                <td><span class="genre-badge">@movie.Genre</span></td>
                               <td class="cell-rating">@string.Format("{0:0.0}/10", movie.Rating)</td>
                                <td>@movie.ReleaseDate.ToShortDateString()</td>
                                <td class="cell-mono">@movie.Runtime min</td>
                                <td class="cell-mono">@movie.Budget.ToString("C")</td>
                                <td class="cell-mono">@movie.Gross.ToString("C")</td>
                                <td class="actions-col">
                                    <div class="d-flex align-items-center gap-1">
                                        <a asp-page="Details" asp-route-id="@movie.Id" class="btn btn-icon" title="View details">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                <circle cx="12" cy="12" r="3"/>
                                            </svg>
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@movie.Id" class="btn btn-icon" title="Edit">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                        </a>
                                        <a asp-page="Delete" asp-route-id="@movie.Id" class="btn btn-icon btn-icon-danger" title="Delete">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                <line x1="10" y1="11" x2="10" y2="17"/>
                                                <line x1="14" y1="11" x2="14" y2="17"/>
                                            </svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

<style>
.table-container {
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-hairline, #ebebeb);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
}

.table-container thead th {
    font-size: 12px;
    font-weight: 500;
    padding: 10px 16px;
    background: var(--color-canvas, #fafafa);
    line-height: 16px;
}

.table-container tbody td {
    font-size: 14px;
    padding: 12px 16px;
    line-height: 20px;
}

.table-container tbody tr:last-child td {
    border-bottom: none;
}

.cell-title {
    font-weight: 500 !important;
    color: var(--color-ink, #171717) !important;
}

.cell-mono {
    font-family: ui-monospace, SF Mono, Menlo, monospace !important;
    font-size: 13px !important;
}

.cell-rating {
    font-family: ui-monospace, SF Mono, Menlo, monospace !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    color: var(--color-ink, #171717) !important;
}

.genre-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 400;
    color: var(--color-body, #4d4d4d);
    background: var(--color-canvas, #fafafa);
    border: 1px solid var(--color-hairline, #ebebeb);
    border-radius: 9999px;
    padding: 2px 10px;
    line-height: 18px;
    white-space: nowrap;
}

.actions-col {
    width: 1%;
    white-space: nowrap;
}

.btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--color-muted, #888888);
    cursor: pointer;
    transition: background .15s, color .15s, border-color .15s;
    text-decoration: none;
}

.btn-icon:hover {
    background: var(--color-surface-hover, #f5f5f5);
    color: var(--color-ink, #171717);
    border-color: var(--color-hairline, #ebebeb);
}

.btn-icon-danger:hover {
    background: #fef2f2;
    color: #ee0000;
    border-color: #fecaca;
}

.empty-state {
    text-align: center;
    padding: 64px 24px;
    background: #fafafa;
    border: 1px dashed #d4d4d4;
    border-radius: 12px;
}

.empty-state-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-ink, #171717);
    margin: 0 0 8px;
    line-height: 28px;
    letter-spacing: -0.6px;
}

.empty-state-text {
    font-size: 14px;
    font-weight: 400;
    color: var(--color-muted, #888888);
    margin: 0 0 24px;
    line-height: 20px;
}

@@media (max-width: 767px) {
    .empty-state {
        padding: 48px 16px;
    }
}
</style>