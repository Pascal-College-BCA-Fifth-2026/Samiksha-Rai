@page "{id}"
@model MovieManager.Pages.Movies.DeleteModel

<div class="page-header">
    <h1>Delete Movie</h1>
    <p>Are you sure you want to delete this movie? This action cannot be undone.</p>
</div>

<form method="post">
    <div class="card delete-card">
        <div class="delete-warning">
            <div class="delete-warning-icon">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 4.5v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <circle cx="8" cy="11.5" r="0.75" fill="currentColor"/>
                </svg>
            </div>
            <div class="delete-warning-content">
                <strong>You are about to delete this item</strong>
                <p>This will permanently remove @Model.Movie.Title from the system.</p>
            </div>
        </div>

        <div class="detail-grid">
            <div class="detail-item">
                <span class="detail-label">Title</span>
                <span class="detail-value">@Model.Movie.Title</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Genre</span>
                <span class="detail-value">@Model.Movie.Genre</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Rating</span>
                <span class="detail-value">@Model.Movie.Rating</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Release Date</span>
                <span class="detail-value">@Model.Movie.ReleaseDate.ToShortDateString()</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Runtime</span>
                <span class="detail-value">@Model.Movie.Runtime min</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Budget</span>
                <span class="detail-value">@Model.Movie.Budget.ToString("C")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Gross</span>
                <span class="detail-value">@Model.Movie.Gross.ToString("C")</span>
            </div>
            <div class="detail-item full-width">
                <span class="detail-label">Summary</span>
                <span class="detail-value">@Model.Movie.Summary</span>
            </div>
        </div>
        <div class="page-actions">
            <button type="submit" class="btn btn-danger">Delete Movie</button>
            <a class="btn btn-outline" asp-page="Index">Cancel</a>
        </div>
    </div>
</form>