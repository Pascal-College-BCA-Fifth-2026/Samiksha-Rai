<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MovieManager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <script type="importmap"></script>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MovieManager.styles.css" asp-append-version="true" />
    <style>
        .nav-link.active,
        .nav-link.active:hover {
        background: var(--color-surface-hover);
        color: var(--color-ink);
        }

        .dashboard-theme .nav-link.active {
        background: rgba(42, 254, 183, 0.12);
        color: var(--color-accent);
        }

        .nav-version {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        }

        .version-badge {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--color-muted);
        background: var(--color-canvas);
        padding: 2px 10px;
        border-radius: var(--radius-full);
        border: 1px solid var(--color-hairline);
        letter-spacing: 0.01em;
        line-height: 1.5;
        }

        @@media (min-width: 768px) {
        .nav-menu.collapse {
        display: flex;
        }
        }
    </style>
</head>

<body
    class="@((ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Dashboard") == true) ? "dashboard-theme" : "")">
    <header class="site-header">
        <div class="nav-container">
            <div class="nav-inner">
                <a class="nav-logo" asp-area="" asp-page="/Index">MovieManager</a>
                
                <div class="nav-menu collapse" id="navbarNav">
                    <ul class="nav-links">
                        <li><a class="nav-link@(ViewContext.RouteData.Values["page"]?.ToString() == "/Dashboard/Index" ? " active" : "")"
                                   asp-page="/Dashboard/Index">Dashboard</a></li>
                            <li><a class="nav-link@(ViewContext.RouteData.Values["page"]?.ToString() == "/Movies/Index" ? " active" : "")"
                                       asp-page="/Movies/Index">Movies</a></li>
                                <li><a class="nav-link@(ViewContext.RouteData.Values["page"]?.ToString() == "/Actors/Index" ? " active" : "")"
                                           asp-page="/Actors/Index">Actors</a></li>
                                    <li><a class="nav-link@(ViewContext.RouteData.Values["page"]?.ToString() == "/Characters/Index" ? " active" : "")"
                                               asp-page="/Characters/Index">Characters</a></li>
                                    </ul>
                                </div>
                                <div class="nav-version d-none d-md-block">
                                    <span class="version-badge">Samiksha Rai</span>
                                </div>
                            </div>
                        </div>
                    </header>
                    <main class="site-main">
                        <div class="page-container">
                            @RenderBody()
                        </div>
                    </main>
                   
                    <script src="~/lib/jquery/dist/jquery.min.js"></script>
                    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                    <script src="~/js/site.js" asp-append-version="true"></script>
                    @await RenderSectionAsync("Scripts", required: false)
                </body>

            </html>