@page "{id}"
@model MovieManager.Pages.Characters.DeleteModel

<div class="page-header">
    <h1>Delete Character</h1>
    <p>Are you sure you want to delete this character? This action cannot be undone.</p>
</div>

<form method="post">
    <div class="card delete-card">
        <div class="delete-warning">
            <div class="delete-warning-icon">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 4.5v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <circle cx="8" cy="11.5" r="0.75" fill="currentColor"/>
                </svg>
            </div>
            <div class="delete-warning-content">
                <strong>You are about to delete this item</strong>
                <p>This will permanently remove @Model.Character.CharacterName from the system.</p>
            </div>
        </div>

        <div class="detail-grid">
            <div class="detail-item">
                <span class="detail-label">Character Name</span>
                <span class="detail-value">@Model.Character.CharacterName</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Movie</span>
                <span class="detail-value">@Model.Character.Movie.Title</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Actor</span>
                <span class="detail-value">@Model.Character.Actor.Name</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Pay</span>
                <span class="detail-value">@Model.Character.Pay.ToString("C")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Screen Time</span>
                <span class="detail-value">@Model.Character.ScreenTime min</span>
            </div>
        </div>
        <div class="page-actions">
            <button type="submit" class="btn btn-danger">Delete Character</button>
            <a class="btn btn-outline" asp-page="Index">Cancel</a>
        </div>
    </div>
</form>