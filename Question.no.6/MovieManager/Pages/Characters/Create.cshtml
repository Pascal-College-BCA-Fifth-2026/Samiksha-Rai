@page
@model MovieManager.Pages.Characters.CreateModel

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="card-title h3 mb-4">Create Character</h1>

                <form method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Character.MovieId" class="form-label fw-medium"></label>
                            <select asp-for="Character.MovieId" asp-items="Model.MovieList" class="form-select">
                                <option value="">-- Select Movie --</option>
                            </select>
                            <span asp-validation-for="Character.MovieId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Character.ActorId" class="form-label fw-medium"></label>
                            <select asp-for="Character.ActorId" asp-items="Model.ActorList" class="form-select">
                                <option value="">-- Select Actor --</option>
                            </select>
                            <span asp-validation-for="Character.ActorId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Character.CharacterName" class="form-label fw-medium"></label>
                            <input asp-for="Character.CharacterName" class="form-control" placeholder="Character name" />
                            <span asp-validation-for="Character.CharacterName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Character.Pay" class="form-label fw-medium"></label>
                            <input asp-for="Character.Pay" class="form-control" placeholder="$" />
                            <span asp-validation-for="Character.Pay" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Character.ScreenTime" class="form-label fw-medium"></label>
                            <input asp-for="Character.ScreenTime" class="form-control" placeholder="Minutes" />
                            <span asp-validation-for="Character.ScreenTime" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4">Create</button>
                        <a asp-page="Index" class="btn btn-outline-secondary px-4">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>