@page "{id}"
@model MovieManager.Pages.Characters.DetailsModel

<div class="page-header">
    <h1>@Model.Character.CharacterName</h1>
    <p>Character details and casting info</p>
</div>

<div class="card">
    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Character Name</span>
            <span class="detail-value">@Model.Character.CharacterName</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Movie</span>
            <span class="detail-value">@Model.Character.Movie.Title</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Actor</span>
            <span class="detail-value">@Model.Character.Actor.Name</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Pay</span>
            <span class="detail-value">@Model.Character.Pay.ToString("C")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Screen Time</span>
            <span class="detail-value">@Model.Character.ScreenTime min</span>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-page="Edit" asp-route-id="@Model.Character.Id">Edit</a>
        <a class="btn btn-outline" asp-page="Index">Back to List</a>
    </div>
</div>